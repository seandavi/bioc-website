digraph publish {
  graph [rankdir=LR, bgcolor=transparent, fontname="Helvetica",
         nodesep=0.35, ranksep=0.85];
  node  [shape=box, style="rounded,filled", fontname="Helvetica",
         fontsize=12, penwidth=1.3, margin="0.18,0.12"];
  edge  [fontname="Helvetica", fontsize=10, penwidth=1.3, color="#7a7a7a"];

  pr   [label="pull request", fillcolor="#e8e8f5", color="#5a5a9a"];
  main [label="merge to main", fillcolor="#e8e8f5", color="#5a5a9a"];

  prev [label="preview/pr-<n>/\nmutable, deleted on close",
        shape=cylinder, fillcolor="#f2f2f2", color="#888888"];
  imm  [label="site/<sha>/\nIMMUTABLE\n+ site/latest pointer",
        shape=cylinder, fillcolor="#fff3d6", color="#b8860b", penwidth=1.7];

  wk   [label="Cloudflare Worker\nowns the route table",
        fillcolor="#e3f0e3", color="#4a7a4a", penwidth=1.7];
  leg  [label="mirrored legacy content\neverything not yet ported",
        fillcolor="#f2f2f2", color="#888888"];
  vis  [label="visitor", shape=ellipse, fillcolor="#f2f2f2", color="#888888"];

  pr   -> prev [label=" CI build "];
  main -> imm  [label=" CI build "];
  prev -> wk [dir=back]; imm -> wk [dir=back];
  leg  -> wk [dir=back];
  wk   -> vis;

  label = "deploy = move a pointer   ·   rollback = move it back";
  labelloc = b; fontsize = 12; fontcolor = "#4a7a4a";
}
