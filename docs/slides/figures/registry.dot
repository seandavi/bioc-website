digraph registry {
  graph [rankdir=LR, bgcolor=transparent, fontname="Helvetica",
         nodesep=0.3, ranksep=0.8];
  node  [shape=box, style="rounded,filled", fontname="Helvetica",
         fontsize=12, penwidth=1.3, margin="0.28,0.14"];
  edge  [fontname="Helvetica", fontsize=10, penwidth=1.3, color="#7a7a7a"];

  ru   [label="r-universe\nbuild system", shape=ellipse,
        fillcolor="#f2f2f2", color="#888888"];
  poll [label="poll\nevery 15 min", fillcolor="#e8e8f5", color="#5a5a9a"];
  obs  [label="every observation\nkept forever", shape=cylinder,
        fillcolor="#f2f2f2", color="#888888"];
  gate [label="THE PROPAGATION GATE\nwhich builds are fit to publish",
        fillcolor="#fff3d6", color="#b8860b", penwidth=1.8];

  w1 [label="website data\n(/next/ pages)", fillcolor="#e3f0e3", color="#4a7a4a"];
  w2 [label="installable R repository\ninstall.packages(...)",
      fillcolor="#e3f0e3", color="#4a7a4a", penwidth=1.7];
  w3 [label="Parquet archive\nqueryable from DuckDB",
      fillcolor="#e3f0e3", color="#4a7a4a"];

  ru -> poll -> obs -> gate;
  gate -> w1; gate -> w2; gate -> w3;

  label = "the old builders produced the repository, not just the packages";
  labelloc = b; fontsize = 12; fontcolor = "#555555";
}
