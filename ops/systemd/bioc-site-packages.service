[Unit]
Description=Refresh bioconductor.org package data snapshot and rebuild the site
Documentation=https://github.com/seandavi/bioc-website/blob/main/ops/refresh-packages.sh
After=network-online.target
Wants=network-online.target
# Files/updates a GitHub issue with the journal (unit lives in bioc-edge).
OnFailure=bioc-notify@%N.service

[Service]
Type=oneshot
# Same dedicated clone of main as bioc-site-refresh.service. Pull first so a
# merged change to the script takes effect on the next run.
WorkingDirectory=/data/davsean/bioc-site-refresh/bioc-website
ExecStartPre=/usr/bin/git pull -q --ff-only
ExecStart=/data/davsean/bioc-site-refresh/bioc-website/ops/refresh-packages.sh
# A run takes a few minutes, plus up to 30 waiting for a content refresh to
# release the snapshot lock.
TimeoutStartSec=1h
Nice=10
