[Unit]
Description=Refresh bioconductor.org prose/assets snapshot and rebuild the site
Documentation=https://github.com/seandavi/bioc-website/blob/main/ops/refresh-content.sh
After=network-online.target
Wants=network-online.target
# Files/updates a GitHub issue with the journal (unit lives in bioc-edge).
OnFailure=bioc-notify@%N.service

[Service]
Type=oneshot
# Runs from a dedicated clone of main, never a dev checkout. Pull first so a
# merged change to the script takes effect on the next run.
WorkingDirectory=/data/davsean/bioc-site-refresh/bioc-website
ExecStartPre=/usr/bin/git pull -q --ff-only
ExecStart=/data/davsean/bioc-site-refresh/bioc-website/ops/refresh-content.sh
TimeoutStartSec=20min
Nice=10
