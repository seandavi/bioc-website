node_modules/
dist/
# Staged copy of the shared JSON contract; regenerate rather than commit (17 MB).
data/

# Copied verbatim from the upstream repo by `just data-assets` (32 MB).
public/

# The patterns above only match directories. Contributors and agents often
# symlink these three to a shared checkout, and a symlink is not a directory:
# without these lines `git add -A` commits it (it happened: #42).
/node_modules
/data
/public
