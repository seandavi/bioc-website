---
/**
 * The biocViews category browser: /packages/<version>/BiocViews.html
 *
 * tree.json is generated by `pipeline/tree.py` from two genuine origins -- the
 * biocViews vocabulary DOT file and each package's biocViews field -- and
 * regenerates exactly (500/500 nodes) for current releases.
 *
 * Two renderings of the same data, one page:
 *
 *  - The PackageFinder island (React, the site's only hydrated island):
 *    search-first finder over packages and categories. Interactivity IS this
 *    page's content, which is what earns it hydration -- see the island's
 *    header comment for the guardrails.
 *  - A server-rendered <details> tree as the no-JS / no-island fallback,
 *    crawlable and functional on its own; hidden the moment the island
 *    mounts. Same `#___Term` anchors either way (the id format is a contract:
 *    the site header and footer link straight to them).
 */
import TreeNode from './TreeNode.astro';
import PackageFinder from './finder/PackageFinder.tsx';
import { reposFor, loadRepo } from '../lib/packages.js';

const { version, tree, channel = null, other = null } = Astro.props;
const roots = Array.isArray(tree) ? tree : [tree];

// name -> [repoPath, Title], across every repo of this release. The island's
// working data, and the fix for the fallback tree's links (annotation
// packages do not live under /bioc/).
const pkgMap = {};
for (const repo of reposFor(version)) {
  for (const [name, pkg] of Object.entries(loadRepo(version, repo))) {
    pkgMap[name] = [repo, pkg.Title ?? ''];
  }
}
const repoOf = Object.fromEntries(Object.entries(pkgMap).map(([n, v]) => [n, v[0]]));
---
<ul class="breadcrumbs">
  <li><a href="/">Home</a></li>
  <li>Bioconductor {version}</li>
</ul>

<h1>Bioconductor {version} Packages</h1>

<p>
  Looking for something older? See <a href="/about/release-announcements/">past releases</a>
  or the <a href="/about/removed-packages/">packages removed from Bioconductor</a>.
</p>

<PackageFinder client:load {version} {channel} {other} {roots} pkgs={pkgMap} />

<div id="bv-fallback">
  <p>Browse packages by biocViews term. Counts are cumulative over each subtree.</p>
  <div class="biocViewsTreeContainer">
    {roots.map((root) => <TreeNode node={root} version={version} repoOf={repoOf} />)}
  </div>
</div>

<style is:global>
  #bvf .bvf-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0.5rem 0;
  }
  #bvf .bvf-search { margin: 0.5rem 0 1rem; }
  #bvf .bvf-search input {
    width: 100%;
    max-width: 44rem;
    font-size: 1.05rem;
    padding: 0.55rem 0.8rem;
  }
  #bvf .bvf-cats {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: -0.5rem 0 1rem;
    font-size: 0.95em;
  }
  #bvf .bvf-chip {
    border: 1px solid #3792ad;
    color: #1a627c;
    background: none;
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    cursor: pointer;
  }
  #bvf .bvf-columns {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  #bvf .bvf-tree {
    flex: 0 1 22rem;
    min-width: 16rem;
    max-height: 70vh;
    overflow: auto;
    border: 1px solid #d3d7de;
    border-radius: 8px;
    padding: 0.75rem;
  }
  #bvf .bvf-tree ul { list-style: none; margin: 0; padding: 0; }
  /* the vendored lists.css decorates li::before site-wide; not in the tree */
  #bvf .bvf-tree li { list-style: none; margin: 0; padding: 0; }
  #bvf .bvf-tree li::before { content: none; }
  #bvf .bvf-term { display: flex; align-items: baseline; }
  #bvf .bvf-chevron {
    background: none;
    border: none;
    cursor: pointer;
    width: 1.2rem;
    flex: none;
    padding: 0;
    color: #5d657c;
  }
  #bvf .bvf-chevron-none { display: inline-block; }
  #bvf .bvf-name {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.12rem 0.2rem;
    text-align: left;
    font: inherit;
    color: inherit;
  }
  #bvf .bvf-active > .bvf-name { font-weight: 700; color: #1a627c; }
  #bvf .bvf-count { color: #5d657c; font-size: 0.85em; }
  #bvf .bvf-results { flex: 1 1 26rem; min-width: 0; }
  #bvf .bvf-heading { display: flex; align-items: baseline; gap: 0.75rem; }
  #bvf .bvf-clear {
    background: none;
    border: 1px solid #d3d7de;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.7em;
    padding: 0.1rem 0.5rem;
  }
  #bvf table { width: 100%; border-collapse: collapse; }
  #bvf th { text-align: left; }
  #bvf th, #bvf td {
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid #e3e6eb;
    vertical-align: top;
  }
  #bvf .bvf-pkg { white-space: nowrap; }
  #bvf .bvf-badge {
    font-size: 0.7em;
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    background: #eef1f5;
    color: #444c63;
  }
  #bvf .bvf-badge-data-annotation { background: #e8f4ea; color: #2c6e3f; }
  #bvf .bvf-badge-data-experiment { background: #fdf1e2; color: #8a5a18; }
  #bvf .bvf-badge-workflows { background: #ece9f7; color: #4c3d8f; }
  #bvf .bvf-more { margin: 1rem 0; }
  .biocViewsTreeContainer .bv-term { margin: 0.15rem 0 0.15rem 0.75rem; }
  .biocViewsTreeContainer .bv-term > summary { cursor: pointer; }
  .biocViewsTreeContainer .bv-leaf { margin: 0.15rem 0 0.15rem 0.75rem; }
  .biocViewsTreeContainer .bv-count { color: #5d657c; font-size: 0.85em; }
  .biocViewsTreeContainer .bv-pkgs { margin: 0.2rem 0 0.4rem 1.25rem; font-size: 0.9em; }
  .biocViewsTreeContainer .bv-pkgs a { margin-right: 0.5em; white-space: nowrap; }
</style>
