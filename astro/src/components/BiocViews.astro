---
/**
 * The biocViews category browser: /packages/<version>/BiocViews.html
 *
 * tree.json is generated by `pipeline/tree.py` from two genuine origins -- the
 * biocViews vocabulary DOT file and each package's biocViews field -- and
 * regenerates exactly (500/500 nodes) for current releases.
 *
 * Divergence from upstream, deliberate: upstream ships a near-empty page and
 * builds the tree client-side with a jsTree widget that fetches tree.json over
 * XHR. This renders the same tree at build time as nested <details>. Same data,
 * same anchors (`#___Software`, linked directly from the header and footer),
 * but it works without JavaScript, is crawlable, and does not depend on a
 * second request succeeding. Collapse behaviour comes from <details>, a
 * platform feature, instead of the widget.
 */
import TreeNode from './TreeNode.astro';

const { version, tree } = Astro.props;
const roots = Array.isArray(tree) ? tree : [tree];
---
<ul class="breadcrumbs">
  <li><a href="/">Home</a></li>
  <li>Bioconductor {version}</li>
</ul>

<h1>Bioconductor {version} Package Categories</h1>
<p>Browse packages by biocViews term. Counts are cumulative over each subtree.</p>

<div class="biocViewsTreeContainer">
  {roots.map((root) => <TreeNode node={root} version={version} />)}
</div>

<style>
  .biocViewsTreeContainer :global(.bv-term) { margin: 0.15rem 0 0.15rem 0.75rem; }
  .biocViewsTreeContainer :global(.bv-term > summary) { cursor: pointer; }
  .biocViewsTreeContainer :global(.bv-leaf) { margin: 0.15rem 0 0.15rem 0.75rem; }
  .biocViewsTreeContainer :global(.bv-count) { color: #5d657c; font-size: 0.85em; }
  .biocViewsTreeContainer :global(.bv-pkgs) { margin: 0.2rem 0 0.4rem 1.25rem; font-size: 0.9em; }
  .biocViewsTreeContainer :global(.bv-pkgs a) { margin-right: 0.5em; white-space: nowrap; }
</style>
